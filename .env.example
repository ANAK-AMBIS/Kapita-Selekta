# Salin jadi .env.local lalu isi.

# PostgreSQL (mis. Neon). Kosongkan untuk pakai PGlite lokal di folder .data/
DATABASE_URL=

# Rahasia penanda tangan cookie sesi (wajib diganti di produksi)
SESSION_SECRET=ganti-dengan-string-acak-panjang

# Akun admin panel (satu-satunya akun dari env).
# Akun UMKM dibuat admin dari panel dan disimpan di database (tabel "akun"),
# jadi tidak ada variabel env tambahan untuk role umkm.
ADMIN_USER=pemdes
ADMIN_PASS=desa123
